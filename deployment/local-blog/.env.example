PROJECT_NAME=local-blog-v2
PROJECT_PATH=/absolute/path/to/blog-v2

NGINX_HTTP_PORT=8080
# 容器 nginx 綁定位址；前面有主機 nginx 反代時建議 127.0.0.1
NGINX_BIND_ADDR=0.0.0.0

APP_TIMEZONE=Asia/Taipei

# redis 服務的密碼，只給 redis 容器用（最小權限，不灌整份 Laravel .env）。
# 必須與專案根目錄 .env（${PROJECT_PATH}/.env）的 REDIS_PASSWORD 填同一個值，
# 否則 Laravel 連線會跟 redis 容器實際要求的密碼對不上。留空＝沿用現行無密碼行為。
REDIS_PASSWORD=
